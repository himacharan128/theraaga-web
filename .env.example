# RAAGA — theraaga.in
# Copy to .env.local for development. Set these in the Vercel project for deploys.

# ---------------------------------------------------------------------------
# REQUIRED IN PRODUCTION
# ---------------------------------------------------------------------------

# MongoDB Atlas. Pair the cluster region with the Vercel function region:
# Atlas Flex in AWS ap-south-1 (Mumbai) + Vercel bom1 gives ~1ms compute-to-DB
# and keeps the data in-country, which materially strengthens the DPDP position.
#
# Give the application user INSERT-ONLY on raaga.leads with NO find privilege —
# a leaked connection string then cannot exfiltrate enquiries, some of which
# relate to minors.
#
# Without this, a production deploy REFUSES enquiries rather than losing them.
MONGODB_URI=
MONGODB_DB=raaga

# ---------------------------------------------------------------------------
# OPTIONAL — the site runs without these, with documented degradation
# ---------------------------------------------------------------------------

# Resend. Without it, lead notifications are logged to the server console only.
RESEND_API_KEY=
RAAGA_NOTIFY_EMAIL=

# Google Search Console ownership token. Once the domain is verified, paste the
# content value from Google's HTML meta-tag method here and add it in Vercel.
GOOGLE_SITE_VERIFICATION=

# PostHog Cloud EU, proxied through a Next.js rewrite. Without it, analytics
# events are no-ops in production and logged in development.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
