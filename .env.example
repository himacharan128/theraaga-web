# RAAGA — theraaga.in
# Copy to .env.local for development. Set these in the Vercel project for deploys.

# ---------------------------------------------------------------------------
# REQUIRED IN PRODUCTION
# ---------------------------------------------------------------------------

# MongoDB Atlas. Pair the cluster region with the Vercel function region:
# Atlas Flex in AWS ap-south-1 (Mumbai) + Vercel bom1 gives ~1ms compute-to-DB
# and keeps the data in-country, which materially strengthens the DPDP position.
#
# Give the application user INSERT-ONLY on raaga.leads with NO find privilege —
# a leaked connection string then cannot exfiltrate enquiries, some of which
# relate to minors.
#
# Without this, a production deploy REFUSES enquiries rather than losing them.
MONGODB_URI=
MONGODB_DB=raaga

# ---------------------------------------------------------------------------
# PRIVATE ADMIN DASHBOARD — required for admin.theraaga.in
# ---------------------------------------------------------------------------
# This is a SEPARATE Atlas user from MONGODB_URI. It is used only server-side by
# the password-protected dashboard and may read/update raaga.leads plus maintain
# raaga.analytics_daily. Never put it in NEXT_PUBLIC_* or a client bundle.
MONGODB_ADMIN_URI=

# Set these only in Vercel/your local .env.local. Never commit or send a password
# in chat. ADMIN_PASSWORD_HASH is scrypt:<base64 salt>:<base64 hash>; generate it
# locally with `npm run admin:password-hash` and use a newly chosen password.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# OPTIONAL — the site runs without these, with documented degradation
# ---------------------------------------------------------------------------

# Resend. NOT IN USE — email is deliberately out of scope, and theraaga.in has
# no MX/SPF/DKIM. Enquiries are read at /admin/enquiries instead. Setting this
# turns lead notifications on; also set `email` in content/seed/site.ts so the
# address stops being suppressed across the site.
RESEND_API_KEY=
RAAGA_NOTIFY_EMAIL=

# Google Search Console ownership token. Once the domain is verified, paste the
# content value from Google's HTML meta-tag method here and add it in Vercel.
GOOGLE_SITE_VERIFICATION=

# Google Search Console — private server-side OAuth, never a public tracker.
# Create a Google Cloud OAuth web client and add this authorised redirect URI:
# https://admin.theraaga.in/api/admin/search-console/callback
# These live only in Vercel/local .env. Refresh tokens are encrypted before
# storage in MongoDB and are never exposed to a browser or client bundle.
GSC_GOOGLE_CLIENT_ID=
GSC_GOOGLE_CLIENT_SECRET=
GSC_TOKEN_ENCRYPTION_KEY=
GSC_REDIRECT_URI=https://admin.theraaga.in/api/admin/search-console/callback

# Vercel invokes the daily Search Console refresh with this bearer secret.
CRON_SECRET=
